@model Internship_Tracker.Models.ViewModels.ApplicationViewModel

@{
    ViewData["Title"] = "Create Application";
}

<h1>Create Application</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="InternshipId" class="control-label"></label>
                <select asp-for="InternshipId" class="form-control" asp-items="ViewBag.InternshipId"></select>
                <span asp-validation-for="InternshipId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StatusId" class="control-label"></label>
                <select asp-for="StatusId" class="form-control" asp-items="ViewBag.StatusId"></select>
                <span asp-validation-for="StatusId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DateApplied" class="control-label"></label>
                <input asp-for="DateApplied" type="date" class="form-control" />
                <span asp-validation-for="DateApplied" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ReminderDate" class="control-label"></label>
                <input asp-for="ReminderDate" type="date" class="form-control" />
                <span asp-validation-for="ReminderDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to Applications</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
