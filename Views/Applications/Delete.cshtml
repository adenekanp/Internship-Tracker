@model Internship_Tracker.Models.Application

@{
    ViewData["Title"] = "Delete Application";
}

<h1>Delete Application</h1>

<h3>Are you sure you want to delete this application?</h3>
<hr />
<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">
                Company
            </dt>
            <dd class="col-sm-8">
                @Model.Internship?.Company
            </dd>

            <dt class="col-sm-4">
                Position
            </dt>
            <dd class="col-sm-8">
                @Model.Internship?.Position
            </dd>

            <dt class="col-sm-4">
                Status
            </dt>
            <dd class="col-sm-8">
                @Model.Status?.Name
            </dd>

            <dt class="col-sm-4">
                Date Applied
            </dt>
            <dd class="col-sm-8">
                @Model.DateApplied.ToShortDateString()
            </dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="ApplicationId" />
            <button type="submit" class="btn btn-danger">Delete</button> |
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
